<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>${revision}</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>agent-integration-test</artifactId>
    <name>Agent Integration Test</name>
    <description>跨模块集成测试模块（新架构：基于 ChatAppService / ConceptRegistry / SseNotificationProvider）</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 默认跳过集成测试，避免每次 mvn test 都真实调用 LLM。
             需运行时加 -Pintegration 激活。 -->
        <skip.integration.tests>true</skip.integration.tests>
        <!-- aistio 已随默认 reactor 一并构建，默认不排除任何引用 agent-aistio 的集成测试类；
             置为非匹配模式，确保相关测试始终参与编译 / 运行。 -->
        <aistio.test.excludes>**/DOES_NOT_EXIST_AISTIO/**</aistio.test.excludes>
    </properties>

    <dependencies>
        <!-- 依赖所有业务模块进行集成测试 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- agent-business 已废弃，相关旧服务（SmartConversationService 等）已删除 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-text2sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 跨模块：验证「用户画像 → MUSE 剪枝」的只读消费链路 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-muse</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- aistio 管控面对接集成测试依赖（随默认 reactor 一并编译） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-aistio</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 架构纪律门禁：需扫描执行引擎与入口层，确认它们仅经 AgentInvoker 触达框架 Agent -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-execution</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-ingress</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构纪律门禁：把「横切关切 → 唯一权威」映射做成机器可校验事实 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 该模块仅包含测试，无主源码，跳过 jar 产物 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- 默认不排除引用 agent-aistio 的集成测试类（aistio 已随默认 reactor 一并构建）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>${aistio.test.excludes}</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <!-- 架构纪律门禁：随默认 reactor 始终运行，不受 skip.integration.tests 影响 -->
                    <execution>
                        <id>default-test</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <includes>
                                <include>**/ArchitectureAuthorityTest.java</include>
                            </includes>
                        </configuration>
                    </execution>
                    <!-- 真实集成测试：默认跳过，需 -Pintegration 激活（依赖本地 Redis / MySQL / LLM） -->
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.integration.tests}</skip>
                            <excludes>
                                <exclude>**/ArchitectureAuthorityTest.java</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 激活后执行真实集成测试（需本地 Redis / MySQL / LLM 可用） -->
        <profile>
            <id>integration</id>
            <properties>
                <skip.integration.tests>false</skip.integration.tests>
            </properties>
        </profile>
    </profiles>
</project>
