<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>${revision}</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>agent-integration-test</artifactId>
    <name>Agent Integration Test</name>
    <description>跨模块集成测试模块（新架构：基于 ChatAppService / ConceptRegistry / SseNotificationProvider）</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 默认跳过集成测试，避免每次 mvn test 都真实调用 LLM。
             需运行时加 -Pintegration 激活。 -->
        <skip.integration.tests>true</skip.integration.tests>
        <!-- 默认编译排除引用 agent-aistio 的集成测试类（aistio 默认不在 reactor 内）。
             加 -Paistio 时置为不匹配模式，使其随 aistio 模块一并编译 / 运行。 -->
        <aistio.test.excludes>**/aistio/**</aistio.test.excludes>
    </properties>

    <dependencies>
        <!-- 依赖所有业务模块进行集成测试 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-spi</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- agent-business 已废弃，相关旧服务（SmartConversationService 等）已删除 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-text2sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 跨模块：验证「用户画像 → MUSE 剪枝」的只读消费链路 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-muse</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 该模块仅包含测试，无主源码，跳过 jar 产物 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!-- 默认排除引用 agent-aistio 的集成测试类编译（aistio 不在默认 reactor 内）；
                 加 -Paistio 时由 profile 将该排除模式置为不匹配，使测试随模块一并编译。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <testExcludes>
                        <testExclude>${aistio.test.excludes}</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skip>${skip.integration.tests}</skip>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- 激活后执行真实集成测试（需本地 Redis / MySQL / LLM 可用） -->
        <profile>
            <id>integration</id>
            <properties>
                <skip.integration.tests>false</skip.integration.tests>
            </properties>
        </profile>
        <!-- aistio 管控面对接为可选尝鲜能力：默认不引入 agent-aistio，
             故引用其类的集成测试也一并从默认编译中排除；加 -Paistio 时放开。 -->
        <profile>
            <id>aistio</id>
            <properties>
                <aistio.test.excludes>**/DOES_NOT_EXIST_AISTIO/**</aistio.test.excludes>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.yunxi</groupId>
                    <artifactId>agent-aistio</artifactId>
                    <!-- 引用 agent-aistio 的独立尝鲜版本号，与平台 ${revision} 解耦 -->
                    <version>${aistio.revision}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
