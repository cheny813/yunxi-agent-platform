# aistio 控制面编排环境变量样例（复制为同级 .env 后按需覆盖；.env 已被 .gitignore 忽略，切勿提交）。
# 所有变量在 docker-compose.yml 中均有 ${VAR:-默认值} 兜底，留空即使用下方开发默认值。

# 镜像坐标（默认 2.1.0-BETA1；如需切换仓库或版本在此覆盖）
AISTIO_REGISTRY=sca-registry.cn-hangzhou.cr.aliyuncs.com/agentscope
AISTIO_VERSION=2.1.0-BETA1

# 元数据库
AISTIO_POSTGRES_PASSWORD=builder

# 控制面 / 各平面共享密钥
BUILDER_JWT_SECRET=builder-compose-dev-secret-change-in-production-32chars
BUILDER_INTERNAL_TOKEN=compose-local-internal-token-at-least-32chars
BUILDER_VAULT_MASTER_KEY=
CONTROL_PLANE_BOOTSTRAP_PASSWORD=admin
