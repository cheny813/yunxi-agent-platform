<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>${revision}</version>
    <name>yunxi-agent-platform</name>
    <description>AgentScope Platform - Simplified Agent Management Framework</description>

    <!-- 多模块结构（顺序即构建顺序：agent-codec 是最底层，无内部模块依赖） -->
    <modules>
        <module>agent-codec</module>
        <module>agent-config</module>
        <module>agent-spi</module>
        <module>agent-text2sql</module>
        <module>agent-core</module>
        <module>agent-execution</module>
        <module>agent-ingress</module>
        <module>agent-muse</module>
        <module>agent-app</module>
        <module>agent-integration-test</module>
    </modules>

    <!-- 打包类型改为 pom -->
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 项目自身版本：所有模块统一引用该属性，升级版本时只需改此处一处，
             无需逐模块修改 <parent><version>。install/deploy 时由 flatten-maven-plugin 解析为具体版本号。 -->
        <revision>2.0.3</revision>
        <agentscope.version>2.0.3</agentscope.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- surefire argLine 默认空串：未声明 jacoco 的模块 fork JVM 不带覆盖率 agent；
             声明 jacoco 的模块由 prepare-agent 覆盖该属性注入 -javaagent -->
        <argLine></argLine>
        <!-- 修复 jackson-databind 安全漏洞 (GHSA-j3rv-43j4-c7qm 等)，覆盖 Spring Boot 3.5.13 管理的版本 -->
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <!-- 第三方依赖版本 -->
        <okhttp.version>4.12.0</okhttp.version>
        <okio.version>3.6.0</okio.version>
        <socket-io.version>2.1.0</socket-io.version>
        <opentelemetry.version>1.62.0</opentelemetry.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <milvus.version>3.0.1</milvus.version>
        <gson.version>2.10.1</gson.version>
        <postgresql.version>42.7.11</postgresql.version>
        <jjwt.version>0.12.7</jjwt.version>
        <!-- 覆盖 Spring Boot 默认的 protobuf 3.x：micrometer-registry-otlp 与 opentelemetry 的 OTLP proto 由 protobuf 4.x 生成，
             运行时需要 RuntimeVersion 类（protobuf-java 4.26+ 才有），否则启动报 NoClassDefFoundError: com/google/protobuf/RuntimeVersion$RuntimeDomain -->
        <protobuf.version>4.36.1</protobuf.version>
        <!-- 以下第三方依赖版本集中管理，子模块引用时不再写 <version> -->
        <nacos.version>3.2.4</nacos.version>
        <cel.version>0.8.0</cel.version>
        <guava.version>33.6.0-jre</guava.version>
        <agrona.version>2.5.0</agrona.version>
        <spring-ai.version>1.0.0-M5</spring-ai.version>
        <langchain4j.version>0.34.0</langchain4j.version>
        <jsqlparser.version>4.7</jsqlparser.version>
        <!-- 以下依赖在 BOM 之外显式锁定版本，亦集中为属性 -->
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
        <mysql-connector.version>8.3.0</mysql-connector.version>
        <lombok.version>1.18.30</lombok.version>
        <rocketmq-spring-boot.version>2.2.3</rocketmq-spring-boot.version>
        <!-- 以下构建插件版本集中为属性，统一在 pluginManagement 引用 -->
        <exec-maven.version>3.1.0</exec-maven.version>
        <maven-compiler.version>3.11.0</maven-compiler.version>
        <maven-resources.version>3.3.1</maven-resources.version>
        <maven-jar.version>3.4.2</maven-jar.version>
        <maven-surefire.version>3.2.5</maven-surefire.version>
        <maven-pmd.version>3.21.0</maven-pmd.version>
        <flatten-maven.version>1.6.0</flatten-maven.version>
    </properties>

    <!-- 依赖管理（只管理第三方依赖，Spring Boot 依赖由 parent 管理） -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>io.yunxi</groupId>
                <artifactId>agent-codec</artifactId>
                <!-- 用固定的 ${revision}（而非 ${project.version}）：${project.version} 在继承后的子模块有效模型里
                     会解析成「消费模块自身版本」，当 agent-aistio 用 ${aistio.revision}（2.0.4-SNAPSHOT）继承本管理段时，
                     会把 agent-core:2.0.3 的 agent-codec 依赖错误膨胀成 2.0.4-SNAPSHOT 导致解析失败；
                     ${revision} 恒为 2.0.3，跨模块版本一致且不会随子模块版本漂移。 -->
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>io.yunxi</groupId>
                <artifactId>agent-text2sql</artifactId>
                <version>${revision}</version>
            </dependency>

            <!-- MyBatis -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-spring-boot.version}</version>
            </dependency>

            <!-- MySQL Driver -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql-connector.version}</version>
            </dependency>

            <!-- AgentScope Core -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- ============================================================
                 AgentScope 官方扩展 - 直接使用 SDK 原生 API
                 参考: https://java.agentscope.io/en/quickstart/installation.html
                 ============================================================ -->

            <!-- Studio 可视化调试 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-studio</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Studio 依赖：OkHttp -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- Studio 依赖：Socket.IO Client -->
            <dependency>
                <groupId>io.socket</groupId>
                <artifactId>socket.io-client</artifactId>
                <version>${socket-io.version}</version>
            </dependency>

            <!-- Studio 依赖：OpenTelemetry (可选，用于监控) -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- RAG 知识库扩展：仅保留 rag-simple（提供 io.agentscope.core.embedding.EmbeddingModel，
                 被 yunxi 的 YunxiEmbeddingModel 实现；其余平台集成模块在 yunxi 中均无引用，属死依赖） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-rag-simple</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Skill 技能包扩展（Git 仓库加载） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-skill-git-repository</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Harness Agent 运行时 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- A2A Protocol -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-a2a-spring-boot-starter</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
                <scope>provided</scope>
            </dependency>

            <!-- Redis 分布式后端（AgentStateStore + BaseStore + SandboxSnapshot 一站式配置） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-redis</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Resilience4j 熔断器（用于智能降级容错） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Milvus Vector Database SDK -->
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus.version}</version>
            </dependency>

            <!-- Gson (for JSON handling) -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <!-- PostgreSQL Driver (修复安全漏洞 CVE-2025-49146) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- RocketMQ Spring Boot Starter -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>${rocketmq-spring-boot.version}</version>
            </dependency>

            <!-- protobuf 强制锁定 4.x：micrometer-registry-otlp 与 opentelemetry 的 OTLP proto
                 由 protobuf 4.x 生成，运行时需要 RuntimeVersion 类（protobuf-java 4.26+ 才有）。
                 Spring Boot 3.5.13 默认硬编码 protobuf-java 3.25.x，且其 ${protobuf.version} 属性
                 覆盖对硬编码项不生效，故在依赖管理里直接锁定版本（优先级高于被引入的 BOM）。 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>${protobuf.version}</version>
            </dependency>

            <!-- AgentScope aistio 数据面集成扩展（agent-core 引用，统一锁定 ${agentscope.version}） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-aistio</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- AgentScope 模型扩展（2.0.0 起 ChatModel 由 core.model 拆分到独立 extension 模块，agent-core / agent-muse 引用） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-openai</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-dashscope</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-anthropic</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-gemini</artifactId>
                <version>${agentscope.version}</version>
            </dependency>
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-model-ollama</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- OpenTelemetry SDK（agent-core 引用，统一锁定 ${opentelemetry.version}） -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-extension-autoconfigure</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-sdk-metrics</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- Okio（okhttp 传递依赖，agent-core 显式锁定） -->
            <dependency>
                <groupId>com.squareup.okio</groupId>
                <artifactId>okio</artifactId>
                <version>${okio.version}</version>
            </dependency>

            <!-- Resilience4j 限流器 / 超时器（agent-core 引用，统一锁定 ${resilience4j.version}） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-ratelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-timelimiter</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- JWT（jjwt 三件套，统一锁定 ${jjwt.version}） -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>

            <!-- Nacos 客户端（MCP 动态注册协调底座，统一锁定 ${nacos.version}） -->
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-api</artifactId>
                <version>${nacos.version}</version>
            </dependency>

            <!-- CEL 表达式引擎（编排图 condition 节点本地校验，统一锁定 ${cel.version}） -->
            <dependency>
                <groupId>org.projectnessie.cel</groupId>
                <artifactId>cel-core</artifactId>
                <version>${cel.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectnessie.cel</groupId>
                <artifactId>cel-generated-pb</artifactId>
                <version>${cel.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectnessie.cel</groupId>
                <artifactId>cel-generated-antlr</artifactId>
                <version>${cel.version}</version>
            </dependency>

            <!-- Guava / Agrona（agent-core 引用，统一锁定属性版本） -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>org.agrona</groupId>
                <artifactId>agrona</artifactId>
                <version>${agrona.version}</version>
            </dependency>

            <!-- Spring AI（agent-text2sql 引用，统一锁定 ${spring-ai.version}） -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-core</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-openai-spring-boot-starter</artifactId>
                <version>${spring-ai.version}</version>
            </dependency>

            <!-- LangChain4j（agent-text2sql 可选依赖，统一锁定 ${langchain4j.version}） -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-open-ai</artifactId>
                <version>${langchain4j.version}</version>
            </dependency>

            <!-- JSqlParser（SQL 解析，统一锁定 ${jsqlparser.version}） -->
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 统一测试依赖配置 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>${exec-maven.version}</version>
                    <configuration>
                        <mainClass>io.yunxi.platform.AgentPlatformApplication</mainClass>
                        <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler.version}</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <!-- 关闭增量编译：compiler 3.11.0 对依赖/注解处理器变更感知不全，
                             曾误判 testCompile "Nothing to compile" 导致测试类缺失（ClassNotFoundException），
                             统一走全量编译根治 -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven-resources.version}</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire.version}</version>
                    <configuration>
                        <!-- ${argLine} 默认空串（见 <properties>），由 jacoco prepare-agent 注入时覆盖为覆盖率 agent 参数；
                             显式挂载 mockito-core agent 替代运行时 self-attach（JDK 21+ 动态加载警告） -->
                        <argLine>${argLine} -Dfile.encoding=UTF-8 -Dconsole.encoding=UTF-8 -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    </configuration>
                </plugin>

                <!-- PMD 代码质量检查插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>${maven-pmd.version}</version>
                    <configuration>
                        <rulesets>
                            <ruleset>rulesets/java/quickstart.xml</ruleset>
                            <ruleset>rulesets/java/unusedcode.xml</ruleset>
                            <ruleset>rulesets/java/basic.xml</ruleset>
                            <ruleset>rulesets/java/design.xml</ruleset>
                        </rulesets>
                        <targetJdk>17</targetJdk>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- JaCoCo 代码覆盖率插件（统一管理） -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>target/jacoco-report</outputDirectory>
                            </configuration>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.70</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <!-- CI 友好版本：模块版本统一引用 ${revision} 属性（根 pom 一处定义），
             升级版本时只需修改根 pom 的 <revision>，无需逐模块改 <parent><version>。
             flatten-maven-plugin 在 install/deploy 阶段将 ${revision} 解析为具体版本号，
             避免发布到仓库的 POM 残留 ${revision} 占位符导致下游无法解析坐标。 -->
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven.version}</version>
                <configuration>
                    <updatePomFile>false</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <!-- 产物写到 target/（已被 .gitignore 覆盖），避免 .flattened-pom.xml 散落在源码树根目录被误提交 -->
                    <outputDirectory>${project.basedir}/target</outputDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- agent-aistio 为可选尝鲜组件（控制面注册 / gRPC 对话流 / 编排触发器 / 契约与治理 / 任务接活），
         默认 reactor 不含该模块、框架依赖固定为 2.0.3（正式版）；构建时加 -Paistio 一并纳入模块，
         并将 AgentScope-Java 依赖切到 2.0.4-SNAPSHOT（随其 aistio 扩展提供）。 -->
    <profiles>
        <profile>
            <id>aistio</id>
            <properties>
                <!-- aistio 管控面依赖 AgentScope-Java 的 aistio 扩展（随 2.0.4 提供），
                     故启用该 profile 时把框架依赖整体切到 2.0.4-SNAPSHOT；
                     同一 fat jar 只允许一个 io.agentscope:* 版本，请勿单独给 agent-aistio 指其他版本。 -->
                <agentscope.version>2.0.4-SNAPSHOT</agentscope.version>
                <!-- agent-aistio 作为可选尝鲜组件的独立版本号，与平台核心的 ${revision}（2.0.3 正式版）解耦；
                     它追踪 AgentScope-Java 2.0.4-SNAPSHOT 尝鲜线，而它依赖的 agent-core / agent-codec 仍指向 ${revision} 正式版。 -->
                <aistio.revision>2.0.4-SNAPSHOT</aistio.revision>
            </properties>
            <modules>
                <module>agent-aistio</module>
            </modules>
        </profile>
    </profiles>
</project>
