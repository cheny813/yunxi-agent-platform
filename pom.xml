<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.13</version>
        <relativePath/>
    </parent>

    <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>2.0.3</version>
    <name>yunxi-agent-platform</name>
    <description>AgentScope Platform - Simplified Agent Management Framework</description>

    <!-- 多模块结构 -->
    <modules>
        <module>agent-config</module>
        <module>agent-spi</module>
        <module>agent-core</module>
        <module>agent-muse</module>
        <module>agent-app</module>
        <module>agent-text2sql</module>
        <module>agent-integration-test</module>
    </modules>

    <!-- 打包类型改为 pom -->
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <agentscope.version>2.0.3</agentscope.version>
        <jacoco.version>0.8.12</jacoco.version>
        <!-- surefire argLine 默认空串：未声明 jacoco 的模块 fork JVM 不带覆盖率 agent；
             声明 jacoco 的模块由 prepare-agent 覆盖该属性注入 -javaagent -->
        <argLine></argLine>
        <!-- 修复 jackson-databind 安全漏洞 (GHSA-j3rv-43j4-c7qm 等)，覆盖 Spring Boot 3.5.13 管理的版本 -->
        <jackson-bom.version>2.21.4</jackson-bom.version>
        <!-- 第三方依赖版本 -->
        <okhttp.version>4.12.0</okhttp.version>
        <okio.version>3.6.0</okio.version>
        <socket-io.version>2.1.0</socket-io.version>
        <opentelemetry.version>1.62.0</opentelemetry.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <milvus.version>3.0.1</milvus.version>
        <gson.version>2.10.1</gson.version>
        <postgresql.version>42.7.11</postgresql.version>
        <jjwt.version>0.12.7</jjwt.version>
        <!-- 覆盖 Spring Boot 默认的 protobuf 3.x：micrometer-registry-otlp 与 opentelemetry 的 OTLP proto 由 protobuf 4.x 生成，
             运行时需要 RuntimeVersion 类（protobuf-java 4.26+ 才有），否则启动报 NoClassDefFoundError: com/google/protobuf/RuntimeVersion$RuntimeDomain -->
        <protobuf.version>4.36.1</protobuf.version>
    </properties>

    <!-- 依赖管理（只管理第三方依赖，Spring Boot 依赖由 parent 管理） -->
    <dependencyManagement>
        <dependencies>
            <!-- 内部模块 -->
            <dependency>
                <groupId>io.yunxi</groupId>
                <artifactId>agent-text2sql</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- MyBatis -->
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>3.0.3</version>
            </dependency>

            <!-- MySQL Driver -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.3.0</version>
            </dependency>

            <!-- AgentScope Core -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-core</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- ============================================================
                 AgentScope 官方扩展 - 直接使用 SDK 原生 API
                 参考: https://java.agentscope.io/en/quickstart/installation.html
                 ============================================================ -->

            <!-- Studio 可视化调试 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-studio</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Studio 依赖：OkHttp -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp</artifactId>
                <version>${okhttp.version}</version>
            </dependency>

            <!-- Studio 依赖：Socket.IO Client -->
            <dependency>
                <groupId>io.socket</groupId>
                <artifactId>socket.io-client</artifactId>
                <version>${socket-io.version}</version>
            </dependency>

            <!-- Studio 依赖：OpenTelemetry (可选，用于监控) -->
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-api</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry</groupId>
                <artifactId>opentelemetry-exporter-otlp</artifactId>
                <version>${opentelemetry.version}</version>
            </dependency>

            <!-- RAG 知识库扩展：仅保留 rag-simple（提供 io.agentscope.core.embedding.EmbeddingModel，
                 被 yunxi 的 YunxiEmbeddingModel 实现；其余平台集成模块在 yunxi 中均无引用，属死依赖） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-rag-simple</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Skill 技能包扩展（Git 仓库加载） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-skill-git-repository</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Harness Agent 运行时 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-harness</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- A2A Protocol -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-a2a-spring-boot-starter</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Lombok -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>1.18.30</version>
                <scope>provided</scope>
            </dependency>

            <!-- Redis 分布式后端（AgentStateStore + BaseStore + SandboxSnapshot 一站式配置） -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-extensions-redis</artifactId>
                <version>${agentscope.version}</version>
            </dependency>

            <!-- Resilience4j 熔断器（用于智能降级容错） -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>

            <!-- Milvus Vector Database SDK -->
            <dependency>
                <groupId>io.milvus</groupId>
                <artifactId>milvus-sdk-java</artifactId>
                <version>${milvus.version}</version>
            </dependency>

            <!-- Gson (for JSON handling) -->
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>

            <!-- PostgreSQL Driver (修复安全漏洞 CVE-2025-49146) -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- RocketMQ Spring Boot Starter -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-spring-boot-starter</artifactId>
                <version>2.2.3</version>
            </dependency>

            <!-- protobuf 强制锁定 4.x：micrometer-registry-otlp 与 opentelemetry 的 OTLP proto
                 由 protobuf 4.x 生成，运行时需要 RuntimeVersion 类（protobuf-java 4.26+ 才有）。
                 Spring Boot 3.5.13 默认硬编码 protobuf-java 3.25.x，且其 ${protobuf.version} 属性
                 覆盖对硬编码项不生效，故在依赖管理里直接锁定版本（优先级高于被引入的 BOM）。 -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>4.36.1</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java-util</artifactId>
                <version>4.36.1</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 统一测试依赖配置 -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <repositories>
        <repository>
            <id>central</id>
            <url>https://repo1.maven.org/maven2/</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.1.0</version>
                    <configuration>
                        <mainClass>io.yunxi.platform.AgentPlatformApplication</mainClass>
                        <cleanupDaemonThreads>false</cleanupDaemonThreads>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>UTF-8</encoding>
                        <!-- 关闭增量编译：compiler 3.11.0 对依赖/注解处理器变更感知不全，
                             曾误判 testCompile "Nothing to compile" 导致测试类缺失（ClassNotFoundException），
                             统一走全量编译根治 -->
                        <useIncrementalCompilation>false</useIncrementalCompilation>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.30</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                    <configuration>
                        <!-- ${argLine} 默认空串（见 <properties>），由 jacoco prepare-agent 注入时覆盖为覆盖率 agent 参数；
                             显式挂载 mockito-core agent 替代运行时 self-attach（JDK 21+ 动态加载警告） -->
                        <argLine>${argLine} -Dfile.encoding=UTF-8 -Dconsole.encoding=UTF-8 -javaagent:${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar</argLine>
                    </configuration>
                </plugin>

                <!-- PMD 代码质量检查插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <version>3.21.0</version>
                    <configuration>
                        <rulesets>
                            <ruleset>rulesets/java/quickstart.xml</ruleset>
                            <ruleset>rulesets/java/unusedcode.xml</ruleset>
                            <ruleset>rulesets/java/basic.xml</ruleset>
                            <ruleset>rulesets/java/design.xml</ruleset>
                        </rulesets>
                        <targetJdk>17</targetJdk>
                        <failOnViolation>true</failOnViolation>
                        <printFailingErrors>true</printFailingErrors>
                    </configuration>
                    <executions>
                        <execution>
                            <id>pmd-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <!-- JaCoCo 代码覆盖率插件（统一管理） -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                            <configuration>
                                <outputDirectory>target/jacoco-report</outputDirectory>
                            </configuration>
                        </execution>
                        <execution>
                            <id>check</id>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>BUNDLE</element>
                                        <limits>
                                            <limit>
                                                <counter>LINE</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.70</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
