启动项目.bat

# 本地测试文件
.agentscope/

# 运行时产物（Spring Boot 可执行 jar 解包目录）
META-INF/
BOOT-INF/
tmp/**
!tmp/.gitkeep
uploads/
agent-core/uploads/

# IDE 工程文件（Eclipse/VS Code Java，若需 m2e 导入可选择性保留）
.factorypath

# ============================================================
# 文档边界：docs/ 采用白名单，仅公开 docs/guide/ 下的用户文档
# ============================================================
# docs/ 下的架构设计、里程碑台账、产品路线图、调研报告等属内部文档，永不进入开源仓库。
# 只有 docs/guide/（面向使用者的手册）会随仓库发布。
# 新增对外文档请一律放进 docs/guide/ 下，切勿直接放在 docs/ 根目录。
#
# 注意：被 git 追踪过的文件，.gitignore 对其无效 —— 从内部转为公开（或反之）时，
# 需同步执行 `git rm --cached <file>` 才会真正生效。
docs/*
!docs/guide/
docs/guide/**/*.tmp

# ============================================================
# Repowise 本地代码索引与 MCP 配置（开发期工具，不进开源包）
# ============================================================
# Repowise 索引目录：含 git 历史分析，属敏感，绝不进开源包
.repowise/
# 本地 MCP 配置（含本机仓库路径），以 .mcp.json.example 模板进包、实际配置不发布
.mcp.json

# ============================================================
# 内部工作目录与本地工具数据（不进开源包）
# ============================================================
# AI 编码助手的本地会话/配置数据（.comate 为旧拼写条目，保留兼容）
.dumate/
# OpenSpec / SPDD 内部规格与规划工作目录（proposal / design 含内部裁决，属内部文档）
openspec/
# flatten 插件产物（随构建刷新，根与子模块均可能出现）
**/.flattened-pom.xml
# 根目录孤儿 npm 产物（仓库无根 package.json）
/package-lock.json

# ============================================================
# 内部归档与二进制资产（不进开源包）
# ============================================================
# legacy/：旧 agent-* 模块的内部历史归档，仅作本地参照，不参与构建、不随开源仓库发布
/legacy/
# agent-web-sdk 是所有 agent-* 产品前端共享的公共 SDK 层（单一源，随仓库发布）。
# 旧归档副本仍在 legacy/ 下并整体忽略；根目录这份是活跃源，必须纳入版本控制，
# 否则 clone 后各产品前端因缺少 @web-sdk 依赖扫描目标而启动失败。
# 离线容器镜像包（大体积二进制，部署说明中由使用者自行 docker load）
/deploy/dockerEngine/*.tar
# 版权书籍与内部学习资料，一律不入库
*.pdf

