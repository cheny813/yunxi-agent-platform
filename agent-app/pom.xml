<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>${revision}</version>
    </parent>

    <artifactId>agent-app</artifactId>
    <name>Agent App</name>
    <description>应用打包模块 - 聚合 agent-core 等为可执行 Spring Boot JAR</description>

    <dependencies>
        <!-- Agent Config 模块 (配置集中管理) -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-config</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Agent Core（包含 framework、shared、infra） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MUSE 自进化引擎（默认关闭，yunxi.muse.enabled=true 时由 MuseAutoConfiguration 激活） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-muse</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.yunxi.platform.AgentPlatformApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        <!-- 启用 JaCoCo 测试覆盖率报告 -->
        <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
        </plugin>
    </plugins>
</build>

    <!-- aistio 管控面对接为可选尝鲜能力：默认不引入，构建时加 -Paistio 纳入。
         agent-aistio 的 AistioAutoConfiguration 经主类组件扫描（io.yunxi.platform）自动装载。 -->
    <profiles>
        <profile>
            <id>aistio</id>
            <dependencies>
                <dependency>
                    <groupId>io.yunxi</groupId>
                    <artifactId>agent-aistio</artifactId>
                    <!-- 引用 agent-aistio 的独立尝鲜版本号，与平台 ${revision} 解耦 -->
                    <version>${aistio.revision}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
