<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.yunxi</groupId>
    <artifactId>yunxi-agent-platform</artifactId>
    <version>${revision}</version>
    </parent>

    <artifactId>agent-app</artifactId>
    <name>Agent App</name>
    <description>应用打包模块 - 聚合 agent-core 等为可执行 Spring Boot JAR</description>

    <dependencies>
        <!-- Agent Config 模块 (配置集中管理) -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-config</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Agent Core（包含 framework、shared、infra） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 统一执行引擎（独立产品平面模块，实现 agent-core 的 ExecutionEngine 等契约） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-execution</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 统一接入网关（HTTP 入口层，集中所有 @RestController） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-ingress</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- MUSE 自进化引擎（默认关闭，yunxi.muse.enabled=true 时由 MuseAutoConfiguration 激活） -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-muse</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- aistio 管控面对接（注册 / gRPC 对话流 / 编排触发器 / 契约与治理 / 任务接活）；
             AistioAutoConfiguration 经主类组件扫描自动装载，由 yunxi.aistio.enabled 控制是否激活。 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-aistio</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>io.yunxi.platform.AgentPlatformApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        <!-- 启用 JaCoCo 测试覆盖率报告 -->
        <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
        </plugin>
    </plugins>
</build>

</project>
