<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>io.yunxi</groupId>
        <artifactId>yunxi-agent-platform</artifactId>
        <version>${revision}</version>
    </parent>

    <modelVersion>4.0.0</modelVersion>
    <artifactId>agent-aistio</artifactId>
    <name>Agent Aistio Integration</name>
    <description>aistio 控制面 / 数据面集成模块（注册、gRPC 对话流、编排触发器、契约与治理、任务接活）</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- 本模块只依赖平台核心，复用其 Agent 运行时、意图引擎、共享配置 / 编解码与对话服务。
            依赖方向：agent-aistio → agent-core（单向；aistio 可正向引用 core 的任意类）。
            禁止反向依赖：agent-core 不得再引用本模块任何类，否则与上方依赖构成 Maven 循环依赖。
            说明：活跃会话索引 ActiveSessionRegistry 已下沉到 agent-core（io.yunxi.platform.session.registry），
            使 core 无需再反向引用 aistio；aistio 侧对其的引用属正常的 aistio→core 正向依赖。 -->
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-core</artifactId>
            <!-- 指向平台核心的正式版 ${revision}，与 reactor 中实际构建的 agent-core 对齐。 -->
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>io.yunxi</groupId>
            <artifactId>agent-codec</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Lombok（与 agent-core 同作用域，provided 不向调用方传递，本模块需自用） -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 本模块作为库被 agent-app 引入，不参与 spring-boot 重打包，无需 main 类。 -->

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 架构护栏（统一接入网关架构不变量）：编译期禁止本模块声明 @RestController（散装入口必须收编 agent-ingress） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.4.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 库模块不产出可执行 jar，跳过 spring-boot 重打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
