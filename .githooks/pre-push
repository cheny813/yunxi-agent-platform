#!/bin/sh
# yunxi 推送前验证门禁（verify-quality 技能）
# 比提交前门禁更重：密钥扫描 + 严格编译 +（可选）单元测试。
# 单元测试为可选（YK_RUN_TESTS=1），因为完整 reactor 测试在 Windows 上较重。
# 绕过开关：YK_SKIP_VERIFY=1
set -e

if [ "$YK_SKIP_VERIFY" = "1" ]; then
  echo "[verify-quality] 已跳过（YK_SKIP_VERIFY=1）"
  exit 0
fi

echo "[verify-quality] 推送前门禁"

# 1. 密钥扫描（始终执行，阻断式）
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks detect --source . --no-git --redact -v 2>/dev/null; then
    echo "严重：gitleaks 检测到密钥，终止推送。" >&2
    exit 1
  fi
else
  if git diff --cached | grep -iE "^\+" | grep -iE "(password|secret|api[_-]?key|private[_-]?key|token|credential|AWS_|DATABASE_URL|REDIS_PASSWORD)" >/dev/null 2>&1; then
    echo "严重：暂存内容中可能含密钥，终止推送。" >&2
    exit 1
  fi
fi
echo "[verify-quality] 密钥扫描：通过"

# 2. 若改动含 Java/pom，执行严格编译
if git diff --cached --name-only | grep -qE '\.java$|pom\.xml$'; then
  echo "[verify-quality] 检测到 Java/pom 改动 -> 执行严格 javac 编译"
  mvn -o -q '-Dmaven.compiler.compilerId=javac' '-Dmaven.compiler.failOnError=true' test-compile -fae > tmp/verify_prepush.log 2>&1 || {
    echo "编译失败（详见 tmp/verify_prepush.log），终止推送。" >&2
    exit 1
  }
  echo "[verify-quality] 编译：通过"
fi

# 3. 可选单元测试
if [ "$YK_RUN_TESTS" = "1" ]; then
  echo "[verify-quality] 正在运行单元测试"
  mvn -o test -DfailIfNoTests=false > tmp/verify_prepush_test.log 2>&1 || {
    echo "测试失败（详见 tmp/verify_prepush_test.log），终止推送。" >&2
    exit 1
  }
  echo "[verify-quality] 测试：通过"
fi

# 4. 验证凭证
FILES_HASH=$(git diff --cached --name-only | sort | sha256sum | cut -c1-8)
echo "[verify-quality] 验证凭证（嵌入提交 trailer）："
echo "  Validated-By: codebuddy"
echo "  Checks-Run: secret-scan,javac-strict${YK_RUN_TESTS:+,-unit-test}"
echo "  Files-Hash: $FILES_HASH"
