<?xml version="1.0" encoding="UTF-8"?>
<configuration debug="false">

    <!-- 属性定义 -->
    <property name="FILE_LOG_CHARSET" value="UTF-8"/>
    <springProperty scope="context" name="LOG_ACTIVE" source="spring.profiles.active" defaultValue="unknown"/>
    <springProperty scope="context" name="LOG_NAME" source="spring.application.name" defaultValue="yunxi-agent-platform"/>
    <springProperty scope="context" name="LOG_LEVEL" source="logging.level.root" defaultValue="INFO"/>

    <!-- 链路追踪工具类 -->
    <conversionRule conversionWord="traceId" class="ch.qos.logback.classic.pattern.MDCConverter">
        <param name="key" value="traceId"/>
        <param name="defaultValue" value="-"/>
    </conversionRule>

    <!-- 控制台日志格式 - 统一MDC显示 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %magenta([%X{threadId}]) %cyan([%X{traceId}]) %green(%logger{36}) - %msg%n"/>

    <!-- 文件日志格式 - 统一MDC显示 -->
    <property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{threadId}] [%X{traceId}] %logger{36} - %msg%n"/>

    <!-- 控制台Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 文件Appender - 统一写入 <仓库根>/logs/，绝不散落到子模块目录
         优先级：-DLOG_DIR (系统属性) > 环境变量 LOG_DIR > 默认相对路径 logs/
         （start.ps1 已注入 -DLOG_DIR 与 $env:LOG_DIR，保证任意启动目录下都落到仓库根/logs） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR:-${env.LOG_DIR:-logs}}/${LOG_NAME}.log</file>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${FILE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR:-${env.LOG_DIR:-logs}}/${LOG_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- 异步文件Appender -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>false</neverBlock>
        <includeCallerData>false</includeCallerData>
    </appender>

    <!-- 根Logger配置 -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </root>

    <!-- 特定包名日志级别调整 -->
    <logger name="io.yunxi.platform" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <logger name="io.yunxi.platform.shared.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
    </logger>

    <!-- 抑制不重要的日志 -->
    <logger name="org.springframework.boot.autoconfigure" level="WARN"/>
    <logger name="org.apache.tomcat.util.compat" level="INFO"/>
    <logger name="org.apache.catalina.startup.DigesterFactory" level="ERROR"/>

    <!-- 抑制 SSE/HTTP 传输层 DEBUG 日志：流式响应与长连接保活的每个 data chunk 都会以 DEBUG
         打一条（"Received SSE data chunk"），量极大且与业务无关。连接级错误仍以 INFO/WARN 透出，
         不影响诊断，故提到 INFO。注意 model 与 mcp 两个 transport 包缩写同为 i.a.c.m.transport，
         必须分别配置，漏一个就会继续刷屏 -->
    <logger name="io.agentscope.core.mcp.transport" level="INFO"/>
    <logger name="io.agentscope.core.model.transport" level="INFO"/>

</configuration>
